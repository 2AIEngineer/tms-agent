# =============================================================================
#  tms-agent — Gabarit d'environnement (copier vers .env)
# =============================================================================
#  Source de vérité unique : ce fichier est lu par `infra/docker-compose.yml`
#  (via `--env-file ../.env`) et par les services Python lancés sur l'hôte.
#
#  Règle d'infrastructure : PostgreSQL et Redis tournent NATIVEMENT sur l'hôte
#  (comme en production, où ce sont des services managés Azure). Ils ne sont
#  JAMAIS conteneurisés. Les conteneurs les joignent via host.docker.internal.
#
#  Convention de nommage des hôtes :
#    - depuis l'hôte (code Python, psql, redis-cli)  -> localhost
#    - depuis un conteneur                           -> host.docker.internal
#  Les variables *_HOST_DOCKER existent pour cette seconde vue.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (NATIF sur l'hôte — port 5432)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tms_agent_db
POSTGRES_SCHEMA=orchestrator

# Base métier de l'orchestrateur (alertes, outbox, enquêtes, checkpoints)
DATABASE_URL=postgresql://postgres:admin@localhost:5432/tms_agent_db

# Base dédiée aux tests d'intégration : créée et migrée par la suite de tests,
# ses tables sont vidées entre chaque test. Jamais la base de développement.
TEST_DATABASE_URL=postgresql://postgres:admin@localhost:5432/tms_agent_test_db

# Bases techniques dédiées : Langfuse et LiteLLM gèrent leurs propres migrations
LANGFUSE_DATABASE_URL=postgresql://postgres:admin@host.docker.internal:5432/langfuse_db
LITELLM_DATABASE_URL=postgresql://postgres:admin@host.docker.internal:5432/litellm_db

# -----------------------------------------------------------------------------
# Redis (NATIF sur l'hôte — port 6379, sans mot de passe en local)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloisonnement par base logique (l'hôte est partagé avec d'autres projets)
#   db 0 -> autres projets locaux, ne pas utiliser
#   db 1 -> LiteLLM (cache et quotas partagés)
#   db 2 -> Langfuse (file d'ingestion BullMQ)
#   db 3 -> tms-agent (réservé : cooldowns, verrous applicatifs)
REDIS_DB_LITELLM=1
REDIS_DB_LANGFUSE=2
REDIS_DB_APP=3
REDIS_URL=redis://localhost:6379/3

# -----------------------------------------------------------------------------
# ClickHouse (conteneur — stockage analytique des traces Langfuse)
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=default

# -----------------------------------------------------------------------------
# MinIO (conteneur — tient lieu d'Azure Blob Storage en local)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
MINIO_BUCKET=langfuse

# -----------------------------------------------------------------------------
# Langfuse (conteneurs web + worker)
#   Secrets locaux uniquement. Régénérer pour tout autre environnement :
#     openssl rand -hex 32
# -----------------------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<openssl rand -hex 16>
SALT=<openssl rand -hex 16>
ENCRYPTION_KEY=<openssl rand -hex 32>
TELEMETRY_ENABLED=false

# Provisioning automatique au premier démarrage (org, projet, utilisateur, clés)
LANGFUSE_INIT_ORG_ID=pro-orga
LANGFUSE_INIT_ORG_NAME=ProOrga
LANGFUSE_INIT_PROJECT_ID=tms-agent
LANGFUSE_INIT_PROJECT_NAME="TMS Agent"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local123
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local123
LANGFUSE_INIT_USER_EMAIL=dev@example.com
LANGFUSE_INIT_USER_NAME="Dev Local"
LANGFUSE_INIT_USER_PASSWORD=<mot-de-passe-local>

# Clés consommées par les clients (LiteLLM, SDK Python)
LANGFUSE_PUBLIC_KEY=pk-lf-local123
LANGFUSE_SECRET_KEY=sk-lf-local123

# -----------------------------------------------------------------------------
# LiteLLM Proxy (conteneur — passerelle d'inférence)
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-litellm-local-dev-master-key
LITELLM_SALT_KEY=sk-litellm-local-dev-salt-key
LITELLM_BASE_URL=http://localhost:4000
# Vue conteneur-à-conteneur, utilisée par les services dockerisés
LITELLM_INTERNAL_URL=http://litellm-proxy:4000

# -----------------------------------------------------------------------------
# vLLM (conteneur GPU — inférence locale, profil `gpu`)
#   Contrainte matérielle de dev : RTX 4070 Laptop, 8 Go de VRAM.
#
#   La famille Qwen3.5 a l'architecture qu'il nous faut : attention hybride —
#   une couche d'attention complète sur quatre — donc un cache KV assez petit
#   pour 32 768 jetons sur cette carte. Reste à choisir la taille qui tient.
#
#   Mesuré : le 4B ne rentre pas. 9,3 Go en bf16, et 7,79 Go même en FP8,
#   l'encodeur visuel et l'attention linéaire n'étant pas quantifiés. Sa
#   variante 4 bits (4,04 Go) tiendrait, mais demande un téléchargement.
#   Le 2B officiel pèse 4,3 Go, tient, et porte la même architecture.
#
#   Mesuré au démarrage : poids 4,25 Gio, et il ne restait que 0,16 Gio pour le
#   cache KV — vLLM plafonnait alors à 10 336 jetons. D'où les trois réglages
#   qui suivent : 0,95 d'occupation, cache KV en 8 bits (deux fois plus de
#   contexte) et 8 séquences simultanées au lieu de 256 (la mémoire
#   d'activation réservée pour une concurrence que nous n'avons pas).
#
#   `qwen3_coder` et non `hermes` : c'est l'analyseur d'appels d'outils prescrit
#   pour cette famille. `--reasoning-parser qwen3` expose le raisonnement du
#   modèle, que le flux de l'assistant relaie tel quel (`reasoning_delta`).
VLLM_MODEL=Qwen/Qwen3.5-2B
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.95
VLLM_KV_CACHE_DTYPE=fp8
VLLM_MAX_NUM_SEQS=8
VLLM_TOOL_CALL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=qwen3
VLLM_BASE_URL=http://localhost:8001
# `1` : démarrer sans contacter HuggingFace (poids déjà en cache). Utile sur
# une ligne lente ; échoue franchement si le modèle n'est pas déjà téléchargé.
HF_HUB_OFFLINE=0

# -----------------------------------------------------------------------------
# Fournisseurs LLM cloud (repli configuré dans infra/litellm.yaml)
# -----------------------------------------------------------------------------
GROQ_API_KEY=<votre-cle-groq>

# -----------------------------------------------------------------------------
# TMS simulé (x_tms, lancé hors de cette stack)
# -----------------------------------------------------------------------------
TMS_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Appel au chauffeur (service agent)
#   La seule action du système vers l'extérieur, donc la seule dont les limites
#   sont configurables : un exploitant doit pouvoir les resserrer sans toucher
#   au code. Les durées se comptent en temps TMS, comme les cooldowns d'alerte.
#   `false` retire l'outil de la liste donnée au modèle, plutôt que de refuser
#   les appels : un outil absent ne tente pas le modèle.
# -----------------------------------------------------------------------------
DRIVER_CALL_ENABLED=true
DRIVER_CALL_MIN_SEVERITY=high
DRIVER_CALL_MAX_PER_MISSION=3
DRIVER_CALL_MAX_PER_DRIVER=2
DRIVER_CALL_WINDOW_MINUTES=60
DRIVER_CALL_COOLDOWN_MINUTES=15

# -----------------------------------------------------------------------------
# API d'exploitation (ops_api)
#   Seule porte publique du système. `OPS_API_AUTH_DISABLED=true` accepte toute
#   requête sous l'identité ci-dessous : le poste de développement n'a pas de
#   tenant Entra. À ne jamais activer ailleurs — la route /monitoring le signale
#   dans sa réponse, et chaque requête le journalise.
# -----------------------------------------------------------------------------
OPS_API_HOST=127.0.0.1
OPS_API_PORT=8020
OPS_API_CORS_ORIGINS=["http://localhost:5173"]
OPS_API_AUTH_DISABLED=true
OPS_API_DEV_OPERATOR=dev_operator
OPS_API_DEV_ROLES=["ops_supervisor"]

# Microsoft Entra ID (OAuth2/OIDC) — requis dès que l'authentification est active
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=

# Diffusion temps réel des alertes (SSE)
OPS_API_SSE_POLL_INTERVAL_S=2.0
OPS_API_SSE_KEEPALIVE_S=15.0

# -----------------------------------------------------------------------------
# Rapport de situation à heure fixe (service agent, F24)
#   Désactivé par défaut : les heures dépendent de l'exploitation du client, et
#   un rapport produit à une heure qui n'a pas de sens n'est pas lu. Les heures
#   sont celles du fuseau ci-dessous — « 8 h » reste 8 h pour l'agent de suivi,
#   y compris après un changement d'heure. Un rapport ne notifie personne : il
#   est conservé et lu via GET /assistant/reports.
# -----------------------------------------------------------------------------
ASSISTANT_REPORT_ENABLED=false
ASSISTANT_REPORT_TIMES=["08:00","14:00"]
ASSISTANT_REPORT_TIMEZONE=Europe/Paris
ASSISTANT_REPORT_OPERATOR=scheduled_report
ASSISTANT_REPORT_TMS_IDS=[]
ASSISTANT_REPORT_CATCH_UP_MINUTES=30

# -----------------------------------------------------------------------------
# Validation humaine des actions de l'assistant
#   Clore une alerte et appeler un chauffeur sont *préparés* par l'assistant,
#   puis validés par l'opérateur : ce sont les arguments enregistrés qui
#   s'exécutent, le modèle ne repasse pas. Passé ce délai, une proposition est
#   inerte — un accord ne doit pas survivre à la situation qui le justifiait.
# -----------------------------------------------------------------------------
ASSISTANT_ACTION_TTL_MINUTES=15

# -----------------------------------------------------------------------------
# Fenêtre de contexte des agents
#   Plafond de ce qui est envoyé au modèle, place de sa réponse déduite.
#   L'historique est compacté avant l'envoi pour tenir dedans ; au-delà, le
#   fournisseur refuserait la requête entière. Mesuré : le socle d'une enquête
#   (prompt, schémas d'outils, faits) pèse ~3 750 jetons — d'où l'impasse d'une
#   fenêtre de 4 096. Ce plafond suit VLLM_MAX_MODEL_LEN : 32 768 moins la
#   place de la réponse.
# -----------------------------------------------------------------------------
AGENT_MAX_INPUT_TOKENS=28000

# Plafond de jetons produits par tour d'inférence. Sans lui, le modèle peut
# générer jusqu'au bout de sa fenêtre : mesuré, une conclusion d'enquête
# passait de 15 secondes à plus de 10 minutes sur une fenêtre de 32 768.
AGENT_MAX_OUTPUT_TOKENS=1200
