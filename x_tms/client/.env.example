# URL de l'API TMS utilisée par le proxy Vite en développement (défaut : http://127.0.0.1:8000)
TMS_API_URL=http://127.0.0.1:8000

# Appel direct de l'API sans proxy (ex. build servi ailleurs ; nécessite TMS_CORS_ORIGINS côté serveur)
# VITE_TMS_API_URL=http://127.0.0.1:8000

# Intervalle de polling en millisecondes (défaut : 2000)
# VITE_POLL_MS=2000
